{
  "name": "Eufy Security Viewer Bridge (beta)",
  "version": "0.8.40-beta.3",
  "slug": "eufy_viewer_bridge_beta",
  "description": "Beta channel of the Eufy Security Viewer Bridge for opt-in testing. Run only one of the two bridge apps.",
  "url": "https://github.com/keesmod/ha-eufy-cam",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "boot": "manual",
  "init": false,
  "host_network": true,
  "timeout": 20,
  "options": {
    "token": "",
    "diagnostics": false
  },
  "schema": {
    "token": "password",
    "backend": "str?",
    "diagnostics": "bool?",
    "live_max_bitrate": "str?",
    "live_max_streams_per_station": "int(1,4)?",
    "live_max_seconds_mains": "int(120,3600)?",
    "experimental_standalone": "bool?",
    "standalone_recording_probe": "bool?"
  },
  "stage": "experimental"
}
